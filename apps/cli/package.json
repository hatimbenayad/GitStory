{
  "name": "gitstory",
  "version": "0.1.0",
  "description": "Turn any Git repository into an animated, watchable documentary.",
  "type": "module",
  "bin": {
    "gitstory": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@gitstory/core": "workspace:*",
    "@gitstory/extractor": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
